{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "AI_ENABLED": "false",
    "ATRIA_MODEL": "Atria-Dawn"
  },
  "ratelimits": [
    {
      "name": "REFLECTION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false
  }
}
